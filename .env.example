# Copy to .env and fill in. Read by scripts/deploy.sh; env vars override.
BASTION=user@bastion.example.com   # ssh jump host (user@host)
BASTION_PORT=22                    # ssh port of the bastion
TARGET=user@192.0.2.10             # target machine, reached from the bastion
# DEST=muq-viz                     # dir under the target's home
# BIN=build-docker/muq-viz         # binary to deploy
